<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ReStock_PG_Dispositivo_Moveis" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Cores principais -->
    <item name="colorPrimary">@color/blue_dark</item>
    <item name="colorOnPrimary">@color/black</item>

    <item name="colorSecondary">@color/purple_dark</item>
    <item name="colorOnSecondary">@color/white</item>

    <!-- Fundo e superfícies -->
    <item name="colorSurface">@color/dark_surface</item>
    <item name="colorOnSurface">@color/white</item>

    <item name="android:colorBackground">@color/dark_bg</item>
    <item name="colorOnBackground">@color/white</item>

    <!-- Atributos personalizados -->
    <item name="productCardCornerRadius">12dp</item>
    <item name="productCardElevation">1dp</item>
    </style>

    <!-- Splash Screen Theme (Night) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Fundo geral do ecrã -->
        <item name="windowSplashScreenBackground">@color/white</item>
        
        <!-- O nosso logo, envolvido pelo inset para não cortar -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>

        <!-- A linha crucial para remover o círculo -->
        <item name="windowSplashScreenIconBackgroundColor" tools:targetApi="23">@android:color/transparent</item>

        <!-- Tema da app após o splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.ReStock_PG_Dispositivo_Moveis</item>
    </style>
</resources>