        android:left="60dp"
        android:right="60dp"
        android:top="60dp"
        android:bottom="60dp"
        android:gravity="center">
        
        <bitmap
            android:src="@drawable/ic_restock_logo"
            android:gravity="center" />
    </item>
</layer-list>
